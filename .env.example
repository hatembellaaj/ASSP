# Copiez ce fichier en ".env" à la racine du projet et ajustez les valeurs
# avant de lancer `docker compose up -d --build` sur votre serveur.

POSTGRES_USER=mouvplus
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mouvplus

# Générez une valeur aléatoire longue (ex: `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Domaine(s) autorisé(s) à appeler l'API (ex: https://mouvplus.mondomaine.fr)
CORS_ORIGIN=*

# ---------- VISIOCONFÉRENCE (Jitsi auto-hébergé) ----------
# Sous-domaine de la visio : créez un enregistrement DNS A vers l'IP du serveur.
JITSI_DOMAIN=meet.mouvplus.com
# IP publique du serveur (ex: `curl -4 ifconfig.me`), annoncée pour l'audio/vidéo.
JITSI_PUBLIC_IP=
# Secrets : générez chacun avec `openssl rand -hex 32`
JITSI_APP_ID=mouvplus
JITSI_APP_SECRET=
JITSI_JICOFO_PASSWORD=
JITSI_JVB_PASSWORD=
TZ=Europe/Paris

# Mettre à "true" uniquement au tout premier démarrage pour injecter les
# comptes et données de démonstration, puis repasser à "false".
SEED_ON_START=false

# Ports exposés sur l'hôte (choisis pour ne pas entrer en conflit avec vos
# autres conteneurs déjà en place sur le serveur — changez-les si besoin)
BACKEND_PORT=18401
FRONTEND_PORT=18400

# Nom de domaine public du site et email de contact pour le certificat
# Let's Encrypt. Utilisés par le reverse proxy jwilder/nginx-proxy déjà en
# place sur le serveur (variables VIRTUAL_HOST / LETSENCRYPT_HOST) — inutiles
# si vous n'avez pas ce reverse proxy.
DOMAIN=mouvplus.com
LETSENCRYPT_EMAIL=contact@mouvplus.com
